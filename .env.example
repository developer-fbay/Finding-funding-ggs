# Copy to .env and fill in. Empty values are safe: the page runs in demo mode.

# n8n production webhook. Empty = demo mode: nothing is sent and no conversion fires.
VITE_WEBHOOK_URL=

# Google Tag Manager container, e.g. GTM-XXXXXXX. Empty = GTM not loaded.
VITE_GTM_ID=

# Comma-separated live hostnames, e.g. fundingfinder.co.uk (domain not confirmed yet). GTM loads on these and their subdomains only
# (and on any host when the URL contains gtm_debug, for GTM Preview).
VITE_GTM_HOSTS=

# CookieYes site key. Empty = no cookie banner.
VITE_COOKIEYES_ID=

# Hero video. Empty = bundled City time-lapse (src/assets/hero-city.mp4). A URL = use that. "off" = photo only.
VITE_HERO_VIDEO=
